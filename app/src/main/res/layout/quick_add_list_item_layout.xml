<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutQuickAddItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_quick_add_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Icon Container -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_quick_add_icon">

        <ImageView
            android:id="@+id/ivQuickAddIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_calendar"
            app:tint="@color/orange_primary" />
    </FrameLayout>

    <!-- Item Name -->
    <TextView
        android:id="@+id/tvQuickAddName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_add_coffee"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvQuickAddAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_add_coffee_amount"
        android:textColor="@color/orange_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="2dp" />
</LinearLayout>